rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId;
    }

    function isValidProfile() {
      let data = request.resource.data;

      return data.keys().hasAll(['name', 'email', 'role'])
        && data.keys().hasOnly(['name', 'email', 'role'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 254
        && data.role in ['customer', 'merchant'];
    }

    match /users/{userId} {
      allow get: if isOwner(userId);

      allow create: if isOwner(userId)
        && isValidProfile()
        && request.resource.data.email == request.auth.token.email;

      allow update: if isOwner(userId)
        && isValidProfile()
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['name']);

      allow list, delete: if false;
    }

    match /stores/{storeId} {
      function isStoreMerchant() {
        return isOwner(storeId)
          && get(/databases/$(database)/documents/users/$(storeId)).data.role == 'merchant';
      }

      function isValidStore() {
        let data = request.resource.data;
        let requiredFields = ['ownerId', 'name', 'category', 'location', 'address', 'city'];

        return data.keys().hasAll(requiredFields)
          && data.keys().hasOnly(requiredFields.concat(['postalCode']))
	  && data.get('postalCode', '') is string
          && data.ownerId == storeId
          && data.name is string
          && data.name.matches('.*\\S.*')
          && data.category is string
          && data.category.matches('.*\\S.*')
          && data.location is latlng
          && data.address is string
          && data.city is string;
      }

      allow get: if isStoreMerchant();
      allow create: if isStoreMerchant() && isValidStore();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}